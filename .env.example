# ====================================================================
# Orca Labs Pharma HRMS — Frontend Environment Configuration
# ====================================================================

# ─── Host Port (Configurable to prevent conflicts on your VPS) ───────
PORT=9590
FRONTEND_PORT=9590

# ─── Supabase (Production Cloud Database & Realtime) ────────────────
VITE_SUPABASE_URL=https://your-supabase-project.example.com
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here

# ─── Company & Application Identity ─────────────────────────────────
VITE_COMPANY_NAME=Orca Labs
VITE_APP_TITLE=Orca Labs Pharma HRMS

# ─── Google Maps (Address Autocomplete & Geocoding) ─────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Map Display Settings (Default Center) ──────────────────────────
VITE_MAP_DEFAULT_LAT=17.3850
VITE_MAP_DEFAULT_LNG=78.4867
VITE_MAP_DEFAULT_ZOOM=12

# ─── Field Operations ───────────────────────────────────────────────
VITE_OSRM_ENDPOINT=https://router.project-osrm.org
VITE_LIVE_BROADCAST_INTERVAL_MS=10000

# ─── Backend API Connection ──────────────────────────────────────────
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8085
